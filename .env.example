# ก๊อปเป็น .env แล้วเติมค่าจริง
# 5436 = db-dev (ฐานข้อมูลสำหรับพัฒนา) · 5435 = db ของเว็บจริง ระวังอย่าสลับ
DATABASE_URL="postgresql://coopsmile:coopsmile@localhost:5436/coopsmile"

# โดเมนของหลังบ้าน — /admin เปิดได้เฉพาะโดเมนนี้ (กับ localhost) ที่เหลือตอบ 404
# ใส่หลายโดเมนได้ คั่นด้วยจุลภาค เช่น admin.spsccoop.org,spsccoop.org
# (ใช้ตอนย้ายทางเข้า เปิดทางเก่าค้างไว้จนกว่าทางใหม่จะใช้ได้ แล้วค่อยลบออก)
# วิธีเพิ่มซับโดเมนใหม่ดูที่ doc/SUBDOMAIN_ADMIN.md
ADMIN_HOST=admin.spsccoop.org

# โดเมนที่มีไว้ทำงานหลังบ้านล้วน ๆ — เปิดหน้าแรกแล้วพาไป /admin ให้เลย
# ไม่ต้องพิมพ์ /admin ต่อท้ายเอง · ไม่ตั้ง = ไม่พาไปไหน
# ห้ามใส่โดเมนที่มีหน้าเว็บของสมาชิกอยู่ (spsccoop.org) หน้าแรกของเว็บจะหายไปทั้งเว็บ
ADMIN_ROOT_HOST=admin.spsccoop.org

# ที่อยู่เว็บสาธารณะที่สมาชิกเปิดดู — ปุ่ม "เปิดหน้าเว็บไซต์" ในหลังบ้านพาไปที่นี่
# ต้องใส่เต็มรวม https:// เพราะหลังบ้านอยู่คนละโดเมนกับหน้าเว็บ
# ไม่ใส่ = https://spsccoop.org
PUBLIC_SITE_URL=https://spsccoop.org

# token จาก Cloudflare Zero Trust → Networks → Tunnels
TUNNEL_TOKEN=

# คีย์ AI สำหรับ "อ่านภาพประกาศแล้วเติมข้อความให้" (สไลด์หน้าแรก + อัตราดอกเบี้ย)
# ขอที่ https://openrouter.ai/keys — ไม่ใส่ = ปุ่ม AI ถูกซ่อน ระบบยังใช้งานได้ปกติแค่ต้องพิมพ์เอง
OPENROUTER_API_KEY=
# เปลี่ยนรุ่นได้โดยไม่ต้องแก้โค้ด รุ่นที่ใช้ต้องอ่านภาพได้และรองรับ structured outputs
# ไม่ใส่ = anthropic/claude-sonnet-5
AI_MODEL=

# ที่เก็บรูปที่อัปจากหลังบ้าน — ไม่ตั้งค่า = เก็บในเครื่องนี้ที่ /uploads (ใช้งานได้ปกติ)
# ตั้งครบทั้ง 5 ค่าเมื่อไหร่ ระบบจะส่งรูปขึ้น FTP แล้วใช้ URL จากโดเมนนั้นแทน
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# true = FTP over TLS (ถ้าโฮสต์รองรับ) · ไม่ใส่หรือ false = FTP ธรรมดา
FTP_SECURE=false
# โฟลเดอร์ "assets" ฝั่ง FTP เช่น /public_html/assets — ระบบจะแยกโฟลเดอร์ย่อยให้เอง
# banner_slide (แบนเนอร์) · Declar (ประกาศ) · newsletter (จดหมายข่าว) · resultreport (รายงานกิจการ)
FTP_BASE_DIR=
# URL สาธารณะของโฟลเดอร์เดียวกัน เช่น https://www.spsccoop.com/assets
ASSETS_BASE_URL=

# ตัวมิเรอร์หน้าเว็บบนโฮสต์ (php-frontend) — ไม่ตั้ง = ไม่ส่งคำสั่งล้างสำเนา
MIRROR_PURGE_URL=https://www.spsccoop.com/purge.php
MIRROR_PURGE_TOKEN=
MIRROR_WARM_URL=https://www.spsccoop.com/warm.php

# ระบบสำนักงานในวงแลนที่เก็บวันหยุดของสหกรณ์ (QgeniusCoop API)
# หลังบ้าน → วันหยุด จะมีปุ่มดึงข้อมูลมาลงเว็บ · ไม่ใส่ = ซ่อนปุ่มนั้นไป
# ต้องเป็นที่อยู่ที่ "คอนเทนเนอร์" ต่อถึง ไม่ใช่แค่เครื่องที่เปิดเบราว์เซอร์
HOLIDAY_SOURCE_URL=http://192.168.100.142:8080/holidays
# โทเคนให้ service holiday-sync เรียก /api/holidays/sync ได้ (ตั้งเป็นค่าสุ่มยาว ๆ)
# ไม่ตั้ง = เส้นทางนั้นตอบ 404 และตัวดึงอัตโนมัติไม่ทำงาน เหลือแต่ปุ่มกดเองในหลังบ้าน
HOLIDAY_SYNC_TOKEN=

# สถิติผู้เข้าชม
# โดเมนสาธารณะที่นับ — ใส่หลายโดเมนได้ คั่นด้วยจุลภาค (รวมโดเมนย่อย เช่น www)
# โดเมนใน ADMIN_HOST ไม่ถูกนับเสมอ ถึงจะเป็นโดเมนย่อยของที่นับก็ตาม
# ไม่ใส่ = spsccoop.com,spsccoop.org (นับทั้งสองทางที่สมาชิกเข้าเว็บได้)
ANALYTICS_HOST=spsccoop.com,spsccoop.org
# ค่าลับผสมตอนแฮชลายนิ้วมือผู้เข้าชม กันคนเดารหัสย้อนกลับเป็น IP — ตั้งเป็นค่าสุ่มยาว ๆ
ANALYTICS_SALT=
