# ก๊อปเป็น .env แล้วเติมค่าจริง
# 5436 = db-dev (ฐานข้อมูลสำหรับพัฒนา) · 5435 = db ของเว็บจริง ระวังอย่าสลับ
DATABASE_URL="postgresql://coopsmile:coopsmile@localhost:5436/coopsmile"

# โดเมนของหลังบ้าน — /admin เปิดได้เฉพาะโดเมนนี้ (กับ localhost)
ADMIN_HOST=coopsmile.org

# token จาก Cloudflare Zero Trust → Networks → Tunnels
TUNNEL_TOKEN=
