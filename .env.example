# ก๊อปเป็น .env แล้วเติมค่าจริง
# 5436 = db-dev (ฐานข้อมูลสำหรับพัฒนา) · 5435 = db ของเว็บจริง ระวังอย่าสลับ
DATABASE_URL="postgresql://coopsmile:coopsmile@localhost:5436/coopsmile"

# โดเมนของหลังบ้าน — /admin เปิดได้เฉพาะโดเมนนี้ (กับ localhost)
ADMIN_HOST=coopsmile.org

# token จาก Cloudflare Zero Trust → Networks → Tunnels
TUNNEL_TOKEN=

# คีย์ AI สำหรับ "อ่านภาพประกาศแล้วเติมข้อความให้" (สไลด์หน้าแรก + อัตราดอกเบี้ย)
# ขอที่ https://openrouter.ai/keys — ไม่ใส่ = ปุ่ม AI ถูกซ่อน ระบบยังใช้งานได้ปกติแค่ต้องพิมพ์เอง
OPENROUTER_API_KEY=
# เปลี่ยนรุ่นได้โดยไม่ต้องแก้โค้ด รุ่นที่ใช้ต้องอ่านภาพได้และรองรับ structured outputs
# ไม่ใส่ = anthropic/claude-sonnet-5
AI_MODEL=

# ที่เก็บรูปที่อัปจากหลังบ้าน — ไม่ตั้งค่า = เก็บในเครื่องนี้ที่ /uploads (ใช้งานได้ปกติ)
# ตั้งครบทั้ง 5 ค่าเมื่อไหร่ ระบบจะส่งรูปขึ้น FTP แล้วใช้ URL จากโดเมนนั้นแทน
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# true = FTP over TLS (ถ้าโฮสต์รองรับ) · ไม่ใส่หรือ false = FTP ธรรมดา
FTP_SECURE=false
# โฟลเดอร์ปลายทางฝั่ง FTP เช่น /public_html/assets/banner_slide
FTP_BASE_DIR=
# URL สาธารณะของโฟลเดอร์เดียวกัน เช่น https://www.spsccoop.com/assets/banner_slide
ASSETS_BASE_URL=
